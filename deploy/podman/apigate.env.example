# ~/apigate.env   (chmod 600)  - read by the container; never commit
APIGATE_MASTER_KEY=
APIGATE_COOKIE_SECURE=true
APIGATE_HSTS=true
APIGATE_PUBLIC_ORIGIN=https://llm-apis.ans3r.eu
# requests from nginx arrive through the unix socket (real client IP = X-Forwarded-For set by nginx);
# local projects use http://127.0.0.1:18731/v1 (no proxy headers are trusted on TCP)
